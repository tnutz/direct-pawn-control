     ]
    },
    {
     "cmd": "robot",
     "who": "pad",
     "secs": 0.5,
     "buttons": [
      "LTrigTop"
     ]
    }
   ],
   "expect": [
    {
     "probe": "sk2",
     "agg": "any",
     "op": "~=",
     "value": 0,
     "label": "pawn 3: skill 1 (fails if slot 1 is empty)"
    }
   ]
  },
  {
   "secs": 3,
   "text": "Pawn 3: co-op off",
   "cmds": [
    {
     "cmd": "coop",
     "on": false
    },
    {
     "cmd": "robot",
     "who": "all",
     "stop": true
    }
   ],
   "expect": [
    {
     "probe": "errs",
     "agg": "max",
     "op": "==",
     "value": 0,
     "label": "pawn 3: no script errors"
    }
   ]
  }
 ],
 "record": {
  "hz": 10,
  "out": "test_guide/result_party-matrix-4.json",
  "probes": {
   "errs": "local ok, d = pcall(json.load_file, \"dev_status/DirectPawnControl.json\"); return ok and d and d.errors",
   "dpc": "local ok, d = pcall(json.load_file, \"dev_status/DirectPawnControl.json\"); return ok and d and d.info",
   "coop": "local ok, d = pcall(json.load_file, \"DPC_coop.json\"); return ok and d and d.active == true",
   "job0": "local J = {\"Fighter\",\"Archer\",\"Mage\",\"Thief\",\"Warrior\",\"Sorcerer\"}\nlocal pw = H.pawn(0); if not pw then return \"none\" end\nlocal j = pw:call(\"get_Human\"):call(\"get_JobContext\"):get_field(\"CurrentJob\"); return J[j] or tostring(j)",
   "v0": "return H.speed(H.pawn(0), 'pawn0')",
   "act0": "local a, b = H.node(H.pawn(0)), H.node(H.pawn(0), 1)\nlocal function busy(n) n = tostring(n or ''); return n ~= '' and not n:find('Locomotion', 1, true) and not n:find('UpperBodyDefault', 1, true) and not n:find('Liv', 1, true) end\nreturn busy(a) or busy(b)",
   "sk0": "local pw = H.pawn(0); local h = pw and pw:call(\"get_Human\"); return h and h:call(\"get_CustomSkillState\")",
   "node0": "return H.node(H.pawn(0))",
   "job1": "local J = {\"Fighter\",\"Archer\",\"Mage\",\"Thief\",\"Warrior\",\"Sorcerer\"}\nlocal pw = H.pawn(1); if not pw then return \"none\" end\nlocal j = pw:call(\"get_Human\"):call(\"get_JobContext\"):get_field(\"CurrentJob\"); return J[j] or tostring(j)",
   "v1": "return H.speed(H.pawn(1), 'pawn1')",
   "act1": "local a, b = H.node(H.pawn(1)), H.node(H.pawn(1), 1)\nlocal function busy(n) n = tostring(n or ''); return n ~= '' and not n:find('Locomotion', 1, true) and not n:find('UpperBodyDefault', 1, true) and not n:find('Liv', 1, true) end\nreturn busy(a) or busy(b)",
   "sk1": "local pw = H.pawn(1); local h = pw and pw:call(\"get_Human\"); return h and h:call(\"get_CustomSkillState\")",
   "node1": "return H.node(H.pawn(1))",
   "job2": "local J = {\"Fighter\",\"Archer\",\"Mage\",\"Thief\",\"Warrior\",\"Sorcerer\"}\nlocal pw = H.pawn(2); if not pw then return \"none\" end\nlocal j = pw:call(\"get_Human\"):call(\"get_JobContext\"):get_field(\"CurrentJob\"); return J[j] or tostring(j)",
   "v2": "return H.speed(H.pawn(2), 'pawn2')",
   "act2": "local a, b = H.node(H.pawn(2)), H.node(H.pawn(2), 1)\nlocal function busy(n) n = tostring(n or ''); return n ~= '' and not n:find('Locomotion', 1, true) and not n:find('UpperBodyDefault', 1, true) and not n:find('Liv', 1, true) end\nreturn busy(a) or busy(b)",
   "sk2": "local pw = H.pawn(2); local h = pw and pw:call(\"get_Human\"); return h and h:call(\"get_CustomSkillState\")",
   "node2": "return H.node(H.pawn(2))",
   "upper0": "return H.node(H.pawn(0), 1)",
   "upper1": "return H.node(H.pawn(1), 1)",
   "upper2": "return H.node(H.pawn(2), 1)"
  },
  "show": [
   "dpc",
   "job0",
   "job1",
   "job2"
  ]
 }
}