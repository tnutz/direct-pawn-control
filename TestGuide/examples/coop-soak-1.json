{
 "id": "coop-soak-1",
 "title": "Co-op soak: each pawn in turn, the robot presses every action (no hands, about 4 minutes)",
 "requires": {
  "DirectPawnControl": "0.9.125",
  "CameraDistance": "2.9.6",
  "TestGuide": "2.1"
 },
 "intro": "About 4 minutes, nothing to press after End. Open ground, no enemies near, full party, a controller connected. Hands off until PASS / FAIL shows. This is the test for last night's crash: co-op ran 17 s before the game went down. If the game crashes during this test, that is the result; tell Claude at which step.",
 "steps": [
  {
   "secs": 3,
   "text": "HANDS OFF. Getting ready.",
   "cmds": [
    {
     "cmd": "despawn"
    },
    {
     "cmd": "coop",
     "on": false
    },
    {
     "cmd": "release"
    },
    {
     "cmd": "solo",
     "on": false
    }
   ]
  },
  {
   "secs": 3,
   "text": "Checks before anything is pressed",
   "expect": [
    {
     "probe": "binds",
     "agg": "last",
     "op": "~=",
     "value": "",
     "label": "controller layout was read from the game"
    },
    {
     "probe": "kb",
     "agg": "any",
     "label": "keyboard layout was read from the game"
    },
    {
     "probe": "errs",
     "agg": "last",
     "op": "==",
     "value": 0,
     "label": "DirectPawnControl: no errors"
    },
    {
     "probe": "cerrs",
     "agg": "last",
     "op": "==",
     "value": 0,
     "label": "CameraDistance: no errors"
    }
   ]
  },
  {
   "secs": 4,
   "text": "Co-op: player 2 plays party member 1",
   "cmds": [
    {
     "cmd": "coop",
     "idx": 0
    }
   ],
   "expect": [
    {
     "probe": "coop",
     "agg": "any",
     "label": "co-op started on party member 1"
    }
   ]
  },
  {
   "secs": 4,
   "text": "Robot: player 2 walks",
   "cmds": [
    {
     "cmd": "robot",
     "who": "pad",
     "secs": 3,
     "stick": [
      0,
      1
     ]
    }
   ]
  },
  {
   "secs": 4,
   "text": "Robot: player 2 presses AttackS",
   "cmds": [
    {
     "cmd": "robot",
     "who": "pad",
     "secs": 0.5,
     "actions": [
      "AttackS"
     ]
    }
   ],
   "expect": [
    {
     "probe": "coop",
     "agg": "frac",
     "op": "==",
     "value": true,
     "min_frac": 0.9,
     "label": "member 1: co-op still running after AttackS"
    }
   ]
  },
  {
   "secs": 4,
   "text": "Robot: player 2 presses AttackL",
