 "record": {
  "hz": 10,
  "out": "test_guide/result_coop-soak-1.json",
  "probes": {
   "errs": "local ok, d = pcall(json.load_file, 'dev_status/DirectPawnControl.json'); return ok and d and d.errors",
   "cerrs": "local ok, d = pcall(json.load_file, 'dev_status/CameraDistance.json'); return ok and d and d.errors",
   "dpc": "local ok, d = pcall(json.load_file, 'dev_status/DirectPawnControl.json'); return ok and d and d.info",
   "sel": "local D = _G.DPC_dbg; return D and D.R.sel_label",
   "holds": "local D = _G.DPC_dbg; return D and (D.R.holds or 0) or 0",
   "poss": "local D = _G.DPC_dbg; return D ~= nil and D.state.active == true",
   "lock_ok": "local D = _G.DPC_dbg; if not (D and D.state.active and D.state.arisen_lockon_ctrl and D.state.pawn_chara) then return nil end\nlocal c = D.state.arisen_lockon_ctrl:get_field('Chara'); return c ~= nil and c:get_address() == D.state.pawn_chara:get_address()",
   "lockfix": "local D = _G.DPC_dbg; return D and (D.R.lock_fixes or 0) or 0",
   "ring": "local gm = sdk.get_managed_singleton('app.GuiManager'); local u = gm and gm:get_field('MagicBowReticle'); if not u then return false end\nreturn u:call('get_GameObject'):call('get_DrawSelf') == true",
   "shots": "local b = H.dpc_brain(); return b and ((b.presses or 0) + (b.skill_uses or 0)) or 0",
   "skills": "local b = H.dpc_brain(); return b and b.skill_uses or 0",
   "bmode": "local b = H.dpc_brain(); return b and b.mode",
   "world": "local D = _G.DPC_dbg; return D and D.R.world",
   "coop": "local ok, d = pcall(json.load_file, 'DPC_coop.json'); return ok and d and d.active == true",
   "v0": "return H.speed(H.pawn(0), 'pawn0')",
   "va": "return H.speed()",
   "act0": "local a, b = H.node(H.pawn(0)), H.node(H.pawn(0), 1)\nlocal function busy(n) n = tostring(n or ''); return n ~= '' and not n:find('Locomotion', 1, true) and not n:find('UpperBodyDefault', 1, true) and not n:find('Liv', 1, true) end\nreturn busy(a) or busy(b)",
   "binds": "local D = _G.DPC_dbg; return D and D.R.bind and D.R.bind.sig",
   "kb": "local D = _G.DPC_dbg; return D and D.R.kbind ~= nil",
   "map": "local ok, d = pcall(json.load_file, 'DPC_arisen_brain.json'); return ok and d and d.coop and d.coop.map",
   "p2f": "local ok, d = pcall(json.load_file, 'DPC_arisen_brain.json'); return ok and d and d.coop and d.coop.p2_flags",
   "act1": "local a, b = H.node(H.pawn(1)), H.node(H.pawn(1), 1)\nlocal function busy(n) n = tostring(n or ''); return n ~= '' and not n:find('Locomotion', 1, true) and not n:find('UpperBodyDefault', 1, true) and not n:find('Liv', 1, true) end\nreturn busy(a) or busy(b)",
   "act2": "local a, b = H.node(H.pawn(2)), H.node(H.pawn(2), 1)\nlocal function busy(n) n = tostring(n or ''); return n ~= '' and not n:find('Locomotion', 1, true) and not n:find('UpperBodyDefault', 1, true) and not n:find('Liv', 1, true) end\nreturn busy(a) or busy(b)",
   "qres": "local ok, d = pcall(json.load_file, 'DPC_quick.json'); return ok and d and (tostring(d.pawn) .. ' slot ' .. tostring(d.slot) .. ' ' .. tostring(d.name) .. ': ' .. tostring(d.result) .. ' [' .. tostring(d.source) .. ']')",
   "qn": "local ok, d = pcall(json.load_file, 'DPC_quick.json'); return ok and d and d.n or 0",
   "qok": "local ok, d = pcall(json.load_file, 'DPC_quick.json'); return ok and d and (d.result == 'ordered' or d.result == 'slot empty' or d.result == 'no enemy')",
   "qtbl": "local ok, d = pcall(json.load_file, 'DPC_skill_table.json'); return ok and d and d.rows or 0",
   "aimsk": "local ok, d = pcall(json.load_file, 'dev_status/DirectPawnControl.json'); return ok and d and d.aim and d.aim.aim_skills or 0",
   "dead2": "local p = H.pawn(2); return p ~= nil and p:call('get_IsDead') == true",
   "job1": "local D = _G.DPC_dbg; return D and D.state.pawn_job"
  },
  "show": [
   "dpc",
   "map",
   "p2f"
  ]
 }
}